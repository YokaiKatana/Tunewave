{
  "name": "tunewave",
  "version": "1.0.0",
  "description": "A Spotify-style desktop player for YouTube Music",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64"
  },
  "author": "YokaiKatana",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "Tunewave",
  "build": {
    "appId": "app.tunewave.desktop",
    "productName": "Tunewave",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tunewave"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YokaiKatana/tunewave.git"
  }
}